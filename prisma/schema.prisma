generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [postgis]
}

enum Role {
  BUYER
  AGENT
  BUILDER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum AuthProvider {
  EMAIL
  GOOGLE
  PHONE
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum LocationLevel {
  STATE
  CITY
  ZONE
  LOCALITY
  SUB_LOCALITY
  COUNTRY
}

enum ListingType {
  SALE
  RENT
  LEASE
}

enum PropertyType {
  APARTMENT
  VILLA
  PLOT
  INDEPENDENT_HOUSE
  PENTHOUSE
  STUDIO
  COMMERCIAL_OFFICE
  COMMERCIAL_SHOP
  WAREHOUSE
  FARM_HOUSE
  PG
  BUILDER_FLOOR
}

enum PropertyStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  INACTIVE
  EXPIRED
  SOLD
  RENTED
  DELETED
}

enum Facing {
  NORTH
  SOUTH
  EAST
  WEST
  NORTH_EAST
  NORTH_WEST
  SOUTH_EAST
  SOUTH_WEST
}

enum Furnishing {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum PossessionStatus {
  READY_TO_MOVE
  UNDER_CONSTRUCTION
  UPCOMING
}

enum ConstructionStatus {
  NEW_LAUNCH
  UNDER_CONSTRUCTION
  READY_TO_MOVE
}

enum LeadSource {
  PROPERTY_ENQUIRY
  WHATSAPP
  CALL
  SITE_VISIT_REQUEST
  REQUIREMENT_MATCH
  CHAT
}

enum LeadStatus {
  NEW
  ASSIGNED
  CONTACTED
  SITE_VISIT_SCHEDULED
  SITE_VISIT_DONE
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
  SPAM
}

enum PlanTier {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  CANCELLED
  EXPIRED
  PAST_DUE
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum ReportReason {
  PROPERTY_UNAVAILABLE
  WRONG_PRICE
  FAKE_LISTING
  DUPLICATE_LISTING
  INCORRECT_INFO
  SPAM
  OTHER
}

enum ReportStatus {
  PENDING
  INVESTIGATING
  RESOLVED
  DISMISSED
}

enum NotificationType {
  LEAD
  PROPERTY
  PAYMENT
  SYSTEM
  PROMOTION
  VERIFICATION
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  RETRYING
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
  WHATSAPP
  PUSH
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum SeoPageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id               String       @id @default(uuid()) @db.Uuid
  name             String?
  email            String?      @unique
  emailVerified    DateTime?    @map("email_verified")
  phone            String?      @unique
  phoneVerified    DateTime?    @map("phone_verified")
  passwordHash     String?      @map("password_hash")
  role             Role         @default(BUYER)
  status           UserStatus   @default(ACTIVE)
  avatarUrl        String?      @map("avatar_url")
  image            String?
  authProvider     AuthProvider @default(EMAIL) @map("auth_provider")
  googleId         String?      @unique @map("google_id")
  lastLoginAt      DateTime?    @map("last_login_at")
  onboardingCompleted Boolean   @default(false) @map("onboarding_completed")
  notificationPreferences Json? @map("notification_preferences")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  accounts         Account[]
  sessions         Session[]
  agent            Agent?
  builder          Builder?
  propertiesVerified Property[] @relation("PropertyVerifiedBy")
  ownedProperties    Property[] @relation("PropertyOwner")
  leads              Lead[]
  buyerRequirements  BuyerRequirement[]
  favorites          Favorite[]
  reviewsGiven       Review[]
  appointments       Appointment[]
  reportsSubmitted   Report[]     @relation("ReportSubmittedBy")
  reportsResolved    Report[]     @relation("ReportResolvedBy")
  notifications      Notification[]
  auditLogs          AuditLog[]
  analyticsEvents    AnalyticsEvent[]
  articles           Article[]
  verificationRecords VerificationRecord[] @relation("VerificationRecordVerifiedBy")

  @@map("users")
}

model Account {
  id                 String  @id @default(uuid()) @db.Uuid
  userId             String  @map("user_id") @db.Uuid
  type               String
  provider           String
  providerAccountId  String  @map("provider_account_id")
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id") @db.Uuid
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Agent {
  id                     String             @id @default(uuid()) @db.Uuid
  userId                 String             @unique @map("user_id") @db.Uuid
  companyName            String?            @map("company_name")
  licenseNumber          String?            @map("license_number")
  experienceYears        Int?               @map("experience_years")
  specializations        String[]
  bio                    String?            @db.Text
  verificationStatus     VerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedAt             DateTime?          @map("verified_at")
  rating                 Decimal?           @default(0) @db.Decimal(3, 2)
  totalReviews           Int                @default(0) @map("total_reviews")
  totalListings          Int                @default(0) @map("total_listings")
  totalDeals             Int                @default(0) @map("total_deals")
  responseRate           Decimal?           @db.Decimal(5, 2) @map("response_rate")
  avgResponseTimeMinutes Int?               @map("avg_response_time_minutes")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties             Property[]
  leadAssignments        LeadAssignment[]
  subscriptions          Subscription[]
  payments               Payment[]
  reviews                Review[]
  appointments           Appointment[]
  reportsTargeted        Report[]           @relation("ReportTargetAgent")
  areasServed            AgentAreaServed[]

  @@map("agents")
}

model Builder {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @map("user_id") @db.Uuid
  companyName        String             @map("company_name")
  slug               String             @unique
  logoUrl            String?            @map("logo_url")
  description        String?            @db.Text
  website            String?
  reraNumber         String?            @map("rera_number")
  reraState          String?            @map("rera_state")
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedAt         DateTime?          @map("verified_at")
  establishedYear    Int?               @map("established_year")
  totalProjects      Int                @default(0) @map("total_projects")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  properties         Property[]
  projects           Project[]
  subscriptions      Subscription[]
  payments           Payment[]

  @@map("builders")
}

model PlatformSetting {
  key         String   @id
  value       Json
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

model Location {
  id               String        @id @default(uuid()) @db.Uuid
  name             String
  slug             String
  level            LocationLevel
  parentId         String?       @map("parent_id") @db.Uuid
  description      String?       @db.Text
  latitude         Decimal?      @db.Decimal(10, 8)
  longitude        Decimal?      @db.Decimal(11, 8)
  pincode          String?
  propertyCount    Int           @default(0) @map("property_count")
  avgPricePerSqft  Decimal?      @db.Decimal(10, 2) @map("avg_price_per_sqft")
  isPopular        Boolean       @default(false) @map("is_popular")
  imageUrl         String?       @map("image_url")
  metaTitle        String?       @map("meta_title")
  metaDescription  String?       @map("meta_description") @db.Text
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  spatialLocation  Unsupported("geometry(Point, 4326)")? @map("spatial_location")

  parent           Location?     @relation("LocationHierarchy", fields: [parentId], references: [id])
  children         Location[]    @relation("LocationHierarchy")
  
  // Relations for properties
  propertiesInLocality Property[] @relation("PropertyLocality")
  propertiesInCity     Property[] @relation("PropertyCity")
  propertiesInState    Property[] @relation("PropertyState")
  
  // Relations for projects
  projectsInLocality   Project[] @relation("ProjectLocality")
  projectsInCity       Project[] @relation("ProjectCity")

  buyerRequirements    BuyerRequirement[]
  articles             Article[]
  seoPagesLocality     SeoPage[] @relation("SeoPageLocality")
  seoPagesCity         SeoPage[] @relation("SeoPageCity")
  nearbyPlacesLocality NearbyPlace[] @relation("NearbyPlaceLocality")
  nearbyPlacesCity     NearbyPlace[] @relation("NearbyPlaceCity")
  priceStats           LocalityPriceStats[]
  agentsServed         AgentAreaServed[]

  @@unique([slug, level, parentId])
  @@index([slug])
  @@index([level])
  @@index([parentId])
  @@index([isPopular])
  @@map("locations")
}

model Property {
  id                 String             @id @default(uuid()) @db.Uuid
  slug               String             @unique
  title              String
  description        String             @db.Text
  listingType        ListingType        @map("listing_type")
  propertyType       PropertyType       @map("property_type")
  subType            String?            @map("sub_type")
  status             PropertyStatus     @default(DRAFT)
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  verificationDate   DateTime?          @map("verification_date")
  verifiedById       String?            @map("verified_by_id") @db.Uuid
  price              BigInt
  pricePerSqft       Decimal?           @db.Decimal(10, 2) @map("price_per_sqft")
  isNegotiable       Boolean            @default(false) @map("is_negotiable")
  priceOnRequest     Boolean            @default(false) @map("price_on_request")
  carpetArea         Decimal?           @db.Decimal(10, 2) @map("carpet_area")
  builtUpArea        Decimal?           @db.Decimal(10, 2) @map("built_up_area")
  superBuiltUpArea   Decimal?           @db.Decimal(10, 2) @map("super_built_up_area")
  plotArea           Decimal?           @db.Decimal(10, 2) @map("plot_area")
  areaUnit           String             @default("SQFT") @map("area_unit")
  bedrooms           Int?
  bathrooms          Int?
  balconies          Int?
  parking            Int?
  floor              Int?
  totalFloors        Int?               @map("total_floors")
  facing             Facing?
  furnishing         Furnishing?
  possessionStatus   PossessionStatus?  @map("possession_status")
  constructionStatus ConstructionStatus? @map("construction_status")
  ageYears           Int?               @map("age_years")
  localityId         String             @map("locality_id") @db.Uuid
  cityId             String             @map("city_id") @db.Uuid
  stateId            String             @map("state_id") @db.Uuid
  address            String?            @db.Text
  pincode            String?
  latitude           Decimal?           @db.Decimal(10, 8)
  longitude          Decimal?           @db.Decimal(11, 8)
  spatialLocation    Unsupported("geometry(Point, 4326)")? @map("spatial_location")
  searchVector       Unsupported("tsvector")? @map("search_vector")
  reraNumber         String?            @map("rera_number")
  reraApproved       Boolean            @default(false) @map("rera_approved")
  
  agentId            String?            @map("agent_id") @db.Uuid
  builderId          String?            @map("builder_id") @db.Uuid
  ownerId            String?            @map("owner_id") @db.Uuid
  projectId          String?            @map("project_id") @db.Uuid
  
  viewCount          Int                @default(0) @map("view_count")
  enquiryCount       Int                @default(0) @map("enquiry_count")
  favoriteCount      Int                @default(0) @map("favorite_count")
  isFeatured         Boolean            @default(false) @map("is_featured")
  isPremium          Boolean            @default(false) @map("is_premium")
  featuredUntil      DateTime?          @map("featured_until")
  publishedAt        DateTime?          @map("published_at")
  expiresAt          DateTime?          @map("expires_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  verifiedBy         User?              @relation("PropertyVerifiedBy", fields: [verifiedById], references: [id])
  locality           Location           @relation("PropertyLocality", fields: [localityId], references: [id])
  city               Location           @relation("PropertyCity", fields: [cityId], references: [id])
  state              Location           @relation("PropertyState", fields: [stateId], references: [id])
  agent              Agent?             @relation(fields: [agentId], references: [id])
  builder            Builder?           @relation(fields: [builderId], references: [id])
  owner              User?              @relation("PropertyOwner", fields: [ownerId], references: [id])
  project            Project?           @relation(fields: [projectId], references: [id])
  
  images             PropertyImage[]
  videos             PropertyVideo[]
  floorPlans         FloorPlan[]
  amenities          PropertyAmenity[]
  leads              Lead[]
  favorites          Favorite[]
  appointments       Appointment[]
  reports            Report[]
  analyticsEvents    AnalyticsEvent[]
  priceHistory       PriceHistory[]

  @@index([cityId, status, listingType])
  @@index([cityId, listingType, price, status])
  @@index([localityId, status, propertyType])
  @@index([agentId, status])
  @@index([builderId, status])
  @@index([verificationStatus, publishedAt])
  @@index([isFeatured])
  @@index([createdAt(sort: Desc)])
  @@index([publishedAt(sort: Desc)])
  @@map("properties")
}

model PropertyImage {
  id           String   @id @default(uuid()) @db.Uuid
  propertyId   String   @map("property_id") @db.Uuid
  url          String
  thumbnailUrl String?  @map("thumbnail_url")
  blurDataUrl  String?  @map("blur_data_url") @db.Text
  altText      String?  @map("alt_text")
  width        Int?
  height       Int?
  sizeBytes    Int?     @map("size_bytes")
  mimeType     String?  @map("mime_type")
  sortOrder    Int      @default(0) @map("sort_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at")

  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_images")
}

model PropertyVideo {
  id              String   @id @default(uuid()) @db.Uuid
  propertyId      String   @map("property_id") @db.Uuid
  url             String
  thumbnailUrl    String?  @map("thumbnail_url")
  durationSeconds Int?     @map("duration_seconds")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")

  property        Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_videos")
}

model FloorPlan {
  id         String    @id @default(uuid()) @db.Uuid
  propertyId String?   @map("property_id") @db.Uuid
  projectId  String?   @map("project_id") @db.Uuid
  title      String
  imageUrl   String    @map("image_url")
  bedrooms   Int?
  bathrooms  Int?
  area       Decimal?  @db.Decimal(10, 2)
  areaUnit   String    @default("SQFT") @map("area_unit")
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at")

  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("floor_plans")
}

model Amenity {
  id              String            @id @default(uuid()) @db.Uuid
  name            String            @unique
  slug            String            @unique
  icon            String?
  category        String?
  
  propertyAmenities PropertyAmenity[]
  projectAmenities  ProjectAmenity[]

  @@map("amenities")
}

model PropertyAmenity {
  propertyId String @map("property_id") @db.Uuid
  amenityId  String @map("amenity_id") @db.Uuid

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@map("property_amenities")
}

model Project {
  id               String            @id @default(uuid()) @db.Uuid
  builderId        String            @map("builder_id") @db.Uuid
  slug             String            @unique
  title            String
  description      String            @db.Text
  localityId       String            @map("locality_id") @db.Uuid
  cityId           String            @map("city_id") @db.Uuid
  address          String?           @db.Text
  latitude         Decimal?          @db.Decimal(10, 8)
  longitude        Decimal?          @db.Decimal(11, 8)
  spatialLocation  Unsupported("geometry(Point, 4326)")? @map("spatial_location")
  startingPrice    BigInt?           @map("starting_price")
  maxPrice         BigInt?           @map("max_price")
  totalUnits       Int?              @map("total_units")
  availableUnits   Int?              @map("available_units")
  totalTowers      Int?              @map("total_towers")
  totalFloors      Int?              @map("total_floors")
  status           PropertyStatus    @default(DRAFT)
  possessionStatus PossessionStatus? @map("possession_status")
  completionDate   DateTime?         @map("completion_date")
  launchDate       DateTime?         @map("launch_date")
  reraNumber       String?           @map("rera_number")
  reraApproved     Boolean           @default(false) @map("rera_approved")
  viewCount        Int               @default(0) @map("view_count")
  enquiryCount     Int               @default(0) @map("enquiry_count")
  isFeatured       Boolean           @default(false) @map("is_featured")
  featuredUntil    DateTime?         @map("featured_until")
  publishedAt      DateTime?         @map("published_at")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  builder          Builder           @relation(fields: [builderId], references: [id], onDelete: Cascade)
  locality         Location          @relation("ProjectLocality", fields: [localityId], references: [id])
  city             Location          @relation("ProjectCity", fields: [cityId], references: [id])
  
  properties       Property[]
  images           ProjectImage[]
  floorPlans       FloorPlan[]
  amenities        ProjectAmenity[]
  leads            Lead[]
  appointments     Appointment[]
  analyticsEvents  AnalyticsEvent[]

  @@map("projects")
}

model ProjectImage {
  id           String   @id @default(uuid()) @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  url          String
  thumbnailUrl String?  @map("thumbnail_url")
  altText      String?  @map("alt_text")
  category     String?
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_images")
}

model ProjectAmenity {
  projectId String @map("project_id") @db.Uuid
  amenityId String @map("amenity_id") @db.Uuid

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([projectId, amenityId])
  @@map("project_amenities")
}

model Lead {
  id               String       @id @default(uuid()) @db.Uuid
  propertyId       String?      @map("property_id") @db.Uuid
  projectId        String?      @map("project_id") @db.Uuid
  requirementId    String?      @map("requirement_id") @db.Uuid
  source           LeadSource
  userId           String?      @map("user_id") @db.Uuid
  name             String?
  phone            String?
  email            String?
  message          String?      @db.Text
  preferredContact String?      @map("preferred_contact")
  utmSource        String?      @map("utm_source")
  utmMedium        String?      @map("utm_medium")
  utmCampaign      String?      @map("utm_campaign")
  referrer         String?
  landingPage      String?      @map("landing_page") @db.Text
  device           String?
  ipAddress        String?      @map("ip_address")
  status           LeadStatus   @default(NEW)
  qualityScore     Int?         @map("quality_score")
  contactedAt      DateTime?    @map("contacted_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  property         Property?    @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  project          Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user             User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  buyerRequirement BuyerRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  
  assignments      LeadAssignment[]
  reviews          Review[]
  appointments     Appointment[]
  events           LeadEvent[]

  @@index([propertyId, createdAt])
  @@index([status, createdAt])
  @@index([phone])
  @@map("leads")
}

model LeadEvent {
  id        String   @id @default(uuid()) @db.Uuid
  leadId    String   @map("lead_id") @db.Uuid
  type      String
  data      Json?
  createdAt DateTime @default(now()) @map("created_at")

  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@map("lead_events")
}

model LeadAssignment {
  id           String     @id @default(uuid()) @db.Uuid
  leadId       String     @map("lead_id") @db.Uuid
  agentId      String     @map("agent_id") @db.Uuid
  status       LeadStatus @default(NEW)
  score        Decimal?   @db.Decimal(5, 2)
  assignedAt   DateTime   @default(now()) @map("assigned_at")
  respondedAt  DateTime?  @map("responded_at")
  notes        String?    @db.Text
  updatedAt    DateTime   @updatedAt @map("updated_at")

  lead         Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agent        Agent      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, status, assignedAt])
  @@map("lead_assignments")
}

model BuyerRequirement {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String?           @map("user_id") @db.Uuid
  listingType      ListingType       @map("listing_type")
  cityId           String            @map("city_id") @db.Uuid
  minBudget        BigInt?           @map("min_budget")
  maxBudget        BigInt?           @map("max_budget")
  minBedrooms      Int?              @map("min_bedrooms")
  maxBedrooms      Int?              @map("max_bedrooms")
  minArea          Decimal?          @db.Decimal(10, 2) @map("min_area")
  maxArea          Decimal?          @db.Decimal(10, 2) @map("max_area")
  possessionStatus PossessionStatus? @map("possession_status")
  furnishing       Furnishing?
  propertyTypes    PropertyType[]
  amenities        String[]
  name             String?
  phone            String?
  whatsapp         String?
  description      String?           @db.Text
  timeline         String?
  isActive         Boolean           @default(true) @map("is_active")
  matchedCount     Int               @default(0) @map("matched_count")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  user             User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  city             Location          @relation(fields: [cityId], references: [id], onDelete: Cascade)
  leads            Lead[]

  @@index([cityId, listingType, isActive])
  @@map("buyer_requirements")
}

model Plan {
  id                   String     @id @default(uuid()) @db.Uuid
  name                 String
  slug                 String     @unique
  tier                 PlanTier
  description          String?    @db.Text
  priceMonthly         BigInt     @map("price_monthly")
  priceYearly          BigInt     @map("price_yearly")
  maxListings          Int        @default(0) @map("max_listings")
  maxFeaturedListings  Int        @default(0) @map("max_featured_listings")
  priorityLeads        Boolean    @default(false) @map("priority_leads")
  analyticsAccess      Boolean    @default(false) @map("analytics_access")
  isActive             Boolean    @default(true) @map("is_active")
  features             Json
  sortOrder            Int        @default(0) @map("sort_order")
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  subscriptions        Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String             @id @default(uuid()) @db.Uuid
  agentId                String?            @map("agent_id") @db.Uuid
  builderId              String?            @map("builder_id") @db.Uuid
  planId                 String             @map("plan_id") @db.Uuid
  status                 SubscriptionStatus @default(INACTIVE)
  razorpaySubscriptionId String?            @map("razorpay_subscription_id")
  currentPeriodStart     DateTime?          @map("current_period_start")
  currentPeriodEnd       DateTime?          @map("current_period_end")
  cancelledAt            DateTime?          @map("cancelled_at")
  createdAt              DateTime           @default(now()) @map("created_at")
  updatedAt              DateTime           @updatedAt @map("updated_at")

  agent                  Agent?             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  builder                Builder?           @relation(fields: [builderId], references: [id], onDelete: Cascade)
  plan                   Plan               @relation(fields: [planId], references: [id])
  payments               Payment[]

  @@map("subscriptions")
}

model Payment {
  id                   String        @id @default(uuid()) @db.Uuid
  subscriptionId       String?       @map("subscription_id") @db.Uuid
  agentId              String?       @map("agent_id") @db.Uuid
  builderId            String?       @map("builder_id") @db.Uuid
  amount               BigInt
  currency             String        @default("INR")
  status               PaymentStatus @default(PENDING)
  razorpayOrderId      String        @unique @map("razorpay_order_id")
  razorpayPaymentId    String?       @unique @map("razorpay_payment_id")
  razorpaySignature    String?       @map("razorpay_signature")
  paymentMethod        String?       @map("payment_method")
  description          String?
  receiptNumber        String?       @map("receipt_number")
  refundAmount         BigInt?       @map("refund_amount")
  metadata             Json?
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  subscription         Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  agent                Agent?        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  builder              Builder?      @relation(fields: [builderId], references: [id], onDelete: Cascade)
  invoices             Invoice[]

  @@index([agentId, status])
  @@index([builderId, status])
  @@map("payments")
}

model Invoice {
  id            String   @id @default(uuid()) @db.Uuid
  paymentId     String   @map("payment_id") @db.Uuid
  invoiceNumber String   @unique @map("invoice_number")
  amount        BigInt
  taxAmount     BigInt   @map("tax_amount")
  totalAmount   BigInt   @map("total_amount")
  pdfUrl        String?  @map("pdf_url")
  createdAt     DateTime @default(now()) @map("created_at")

  payment       Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("invoices")
}

model Favorite {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@index([userId, createdAt])
  @@index([propertyId])
  @@map("favorites")
}

model Review {
  id         String   @id @default(uuid()) @db.Uuid
  agentId    String   @map("agent_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  leadId     String?  @map("lead_id") @db.Uuid
  rating     Int      @db.SmallInt
  title      String?
  content    String   @db.Text
  isVerified Boolean  @default(false) @map("is_verified")
  isVisible  Boolean  @default(true) @map("is_visible")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead       Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@map("reviews")
}

model Appointment {
  id            String            @id @default(uuid()) @db.Uuid
  leadId        String?           @map("lead_id") @db.Uuid
  propertyId    String?           @map("property_id") @db.Uuid
  projectId     String?           @map("project_id") @db.Uuid
  userId        String?           @map("user_id") @db.Uuid
  agentId       String            @map("agent_id") @db.Uuid
  scheduledDate DateTime          @map("scheduled_date") @db.Date
  scheduledTime String            @map("scheduled_time")
  status        AppointmentStatus @default(REQUESTED)
  notes         String?           @db.Text
  userPhone     String?           @map("user_phone")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")

  lead          Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  property      Property?         @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  project       Project?          @relation(fields: [projectId], references: [id], onDelete: SetNull)
  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  agent         Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@map("appointments")
}

model Report {
  id              String       @id @default(uuid()) @db.Uuid
  reporterId      String?      @map("reporter_id") @db.Uuid
  propertyId      String?      @map("property_id") @db.Uuid
  agentId         String?      @map("agent_id") @db.Uuid
  reason          ReportReason
  description     String?      @db.Text
  status          ReportStatus @default(PENDING)
  resolvedById    String?      @map("resolved_by_id") @db.Uuid
  resolvedAt      DateTime?    @map("resolved_at")
  resolutionNotes String?      @map("resolution_notes") @db.Text
  createdAt       DateTime     @default(now()) @map("created_at")

  reporter        User?        @relation("ReportSubmittedBy", fields: [reporterId], references: [id], onDelete: SetNull)
  property        Property?    @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  agent           Agent?       @relation("ReportTargetAgent", fields: [agentId], references: [id], onDelete: Cascade)
  resolvedBy      User?        @relation("ReportResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)

  @@map("reports")
}

model Notification {
  id                String              @id @default(uuid()) @db.Uuid
  userId            String              @map("user_id") @db.Uuid
  type              NotificationType
  channel           NotificationChannel
  title             String
  body              String              @db.Text
  data              Json?
  status            NotificationStatus  @default(PENDING)
  providerMessageId String?             @map("provider_message_id")
  isRead            Boolean             @default(false) @map("is_read")
  readAt            DateTime?           @map("read_at")
  sentAt            DateTime?           @map("sent_at")
  createdAt         DateTime            @default(now()) @map("created_at")

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model VerificationRecord {
  id           String             @id @default(uuid()) @db.Uuid
  entityType   String             @map("entity_type")
  entityId     String             @map("entity_id") @db.Uuid
  verifiedById String             @map("verified_by_id") @db.Uuid
  status       VerificationStatus
  notes        String?            @db.Text
  documents    Json?
  createdAt    DateTime           @default(now()) @map("created_at")

  verifiedBy   User               @relation("VerificationRecordVerifiedBy", fields: [verifiedById], references: [id], onDelete: Cascade)

  @@map("verification_records")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model AnalyticsEvent {
  id          String   @id @default(uuid()) @db.Uuid
  eventType   String   @map("event_type")
  userId      String?  @map("user_id") @db.Uuid
  sessionId   String?  @map("session_id")
  propertyId  String?  @map("property_id") @db.Uuid
  projectId   String?  @map("project_id") @db.Uuid
  data        Json?
  utmSource   String?  @map("utm_source")
  utmMedium   String?  @map("utm_medium")
  utmCampaign String?  @map("utm_campaign")
  referrer    String?
  landingPage String?  @map("landing_page") @db.Text
  device      String?
  browser     String?
  os          String?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  property    Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([eventType, createdAt])
  @@index([propertyId, eventType])
  @@map("analytics_events")
}

model Article {
  id               String        @id @default(uuid()) @db.Uuid
  title            String
  slug             String        @unique
  excerpt          String?       @db.Text
  content          String        @db.Text
  featuredImageUrl String?       @map("featured_image_url")
  authorId         String        @map("author_id") @db.Uuid
  category         String?
  tags             String[]
  status           ArticleStatus @default(DRAFT)
  seoTitle         String?       @map("seo_title")
  seoDescription   String?       @map("seo_description") @db.Text
  canonicalUrl     String?       @map("canonical_url")
  localityId       String?       @map("locality_id") @db.Uuid
  viewCount        Int           @default(0) @map("view_count")
  publishedAt      DateTime?     @map("published_at")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  author           User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  locality         Location?     @relation(fields: [localityId], references: [id], onDelete: SetNull)

  @@index([status, publishedAt])
  @@index([slug])
  @@map("articles")
}

model SeoPage {
  id             String        @id @default(uuid()) @db.Uuid
  slug           String        @unique
  title          String
  heading        String?
  description    String?       @db.Text
  content        String?       @db.Text
  cityId         String?       @map("city_id") @db.Uuid
  localityId     String?       @map("locality_id") @db.Uuid
  listingType    ListingType?  @map("listing_type")
  propertyType   PropertyType? @map("property_type")
  bedrooms       Int?
  seoTitle       String?       @map("seo_title")
  seoDescription String?       @map("seo_description") @db.Text
  canonicalUrl   String?       @map("canonical_url")
  isIndexed      Boolean       @default(true) @map("is_indexed")
  ogImageUrl     String?       @map("og_image_url")
  faqs           Json?
  status         SeoPageStatus @default(DRAFT)
  publishedAt    DateTime?     @map("published_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  city           Location?     @relation("SeoPageCity", fields: [cityId], references: [id], onDelete: SetNull)
  locality       Location?     @relation("SeoPageLocality", fields: [localityId], references: [id], onDelete: SetNull)

  @@map("seo_pages")
}

model NearbyPlace {
  id         String    @id @default(uuid()) @db.Uuid
  name       String
  category   String
  latitude   Decimal?  @db.Decimal(10, 8)
  longitude  Decimal?  @db.Decimal(11, 8)
  spatialLocation Unsupported("geometry(Point, 4326)")? @map("spatial_location")
  localityId String?   @map("locality_id") @db.Uuid
  cityId     String?   @map("city_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")

  locality   Location? @relation("NearbyPlaceLocality", fields: [localityId], references: [id], onDelete: SetNull)
  city       Location? @relation("NearbyPlaceCity", fields: [cityId], references: [id], onDelete: SetNull)

  @@map("nearby_places")
}

model PriceHistory {
  id           String   @id @default(uuid()) @db.Uuid
  propertyId   String   @map("property_id") @db.Uuid
  price        BigInt
  pricePerSqft Decimal? @db.Decimal(10, 2) @map("price_per_sqft")
  recordedAt   DateTime @default(now()) @map("recorded_at")

  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("price_history")
}

model LocalityPriceStats {
  id              String       @id @default(uuid()) @db.Uuid
  localityId      String       @map("locality_id") @db.Uuid
  propertyType    PropertyType @map("property_type")
  listingType     ListingType  @map("listing_type")
  bedrooms        Int?
  avgPrice        BigInt       @map("avg_price")
  minPrice        BigInt       @map("min_price")
  maxPrice        BigInt       @map("max_price")
  avgPricePerSqft Decimal?     @db.Decimal(10, 2) @map("avg_price_per_sqft")
  propertyCount   Int          @map("property_count")
  calculatedAt    DateTime     @default(now()) @map("calculated_at")

  locality        Location     @relation(fields: [localityId], references: [id], onDelete: Cascade)

  @@unique([localityId, propertyType, listingType, bedrooms])
  @@map("locality_price_stats")
}

model AgentAreaServed {
  id         String   @id @default(uuid()) @db.Uuid
  agentId    String   @map("agent_id") @db.Uuid
  localityId String   @map("locality_id") @db.Uuid

  agent      Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  locality   Location @relation(fields: [localityId], references: [id], onDelete: Cascade)

  @@unique([agentId, localityId])
  @@map("agent_areas_served")
}
